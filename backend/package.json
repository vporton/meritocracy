{
  "name": "meritocracy-backend",
  "version": "1.0.0",
  "description": "Backend API for meritocracy app",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "npx tsc",
    "db:generate": "prisma generate --config prisma/prisma.config.js",
    "db:push": "prisma db push --config prisma/prisma.config.js",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.js",
    "db:studio": "prisma studio --config prisma/prisma.config.js",
    "test": "npm run test:integration",
    "test:integration": "node scripts/run-integration-tests.js"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "0.38.1",
