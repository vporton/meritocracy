type RoundId = nat64;
type AllocationId = nat64;
type UserId = nat64;
type Hash32 = blob;
type TimestampNs = int;
type AssetId = record { ledger : principal; symbol : text; decimals : nat8 };
type AppError = variant { unauthorized; forbidden; not_found; conflict : text; invalid : text; expired; rate_limited : record { retry_after_ns : nat64 }; paused; transient : text; internal : text };
type InterfaceVersion = record { major : nat16; minor : nat16; patch : nat16; schema_hash : Hash32 };
type Page = record { cursor : opt blob; limit : nat32 };
type RoundStatus = variant { draft; funded; disputing; executing; complete; paused };
type Round = record { id : RoundId; asset : AssetId; source_fund : Hash32; status : RoundStatus; dispute_ends_at : opt TimestampNs; required_atoms : nat; reserved_atoms : nat; vault_subaccount : blob; allocation_version : opt Hash32 };
type AllocationDraft = record { id : AllocationId; user_id : UserId; amount_atoms : nat; evidence_hash : Hash32 };
type Allocation = record { draft : AllocationDraft; recipient_hash : opt Hash32; state : variant { pending; frozen; paid : nat; carried : text } };
type Dispute = record { id : nat64; round_id : RoundId; allocation_id : AllocationId; evidence_hash : Hash32; reason_code : text; state : variant { open; upheld; rejected }; created_at : TimestampNs };
type DisputeResolution = variant { uphold; reject };
type ExecutionSummary = record { prepared : nat32; sent : nat32; retryable : nat32; carried : nat32 };
type Reconciliation = record { round_id : RoundId; ledger_atoms : nat; reserved_atoms : nat; reconciled : bool; checked_at : TimestampNs };
type RoundPage = record { items : vec Round; next_cursor : opt blob };
type AllocationPage = record { items : vec Allocation; next_cursor : opt blob };
type ResultRound = variant { ok : Round; err : AppError };
type ResultHash = variant { ok : Hash32; err : AppError };
type ResultDispute = variant { ok : Dispute; err : AppError };
type ResultExecution = variant { ok : ExecutionSummary; err : AppError };
type ResultReconciliation = variant { ok : Reconciliation; err : AppError };
type ResultRounds = variant { ok : RoundPage; err : AppError };
type ResultAllocations = variant { ok : AllocationPage; err : AppError };
service : {
  interface_version : () -> (InterfaceVersion) query;
  create_draft : (record { asset : AssetId; source_fund : Hash32; required_atoms : nat }) -> (ResultRound);
  put_allocation_version : (record { round_id : RoundId; expected_previous_version : opt Hash32; allocations : vec AllocationDraft }) -> (ResultHash);
  get_round : (RoundId) -> (ResultRound) query;
  list_rounds : (record { status : opt RoundStatus; page : Page }) -> (ResultRounds) query;
  list_allocations : (RoundId, Page) -> (ResultAllocations) query;
  verify_funding : (RoundId) -> (ResultRound);
  finalize : (RoundId) -> (ResultRound);
  file_dispute : (record { round_id : RoundId; allocation_id : AllocationId; evidence_hash : Hash32; reason_code : text }) -> (ResultDispute);
  resolve_dispute : (record { dispute_id : nat64; resolution : DisputeResolution }) -> (ResultDispute);
  execute_due : (RoundId) -> (ResultExecution);
  retry_execution : (RoundId) -> (ResultExecution);
  reconcile : (RoundId) -> (ResultReconciliation);
}
