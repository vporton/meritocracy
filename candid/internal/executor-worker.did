// Ledger/executor worker interface. It cannot create an entitlement or alter an amount.
type Id = text; type Version = nat64; type Timestamp = nat64;
type ApiError = record { code : variant { invalid_input; unauthenticated; unauthorized; not_found; conflict; duplicate_operation; invalid_state_transition; resource_limit; external_dependency_unavailable; temporary_failure; internal_invariant_violation }; message : text; retryable : bool; correlation_id : opt Id; field : opt text };
type ExecutionClaim = record { obligation_id : Id; expected_version : Version; lease_token : blob };
type ExecutionInstruction = record { obligation_id : Id; network : text; asset : text; amount : nat; destination_commitment : blob; memo : blob; lease_expires_at : Timestamp };
type SettlementObservation = record { observation_id : Id; obligation_id : Id; expected_version : Version; state : variant { settled; proven_unsent; ambiguous; failed }; receipt_commitment : opt blob; observed_at : Timestamp; reason_code : opt text };
service : { claim_execution : (ExecutionClaim) -> (variant { ok : ExecutionInstruction; err : ApiError }); submit_settlement_observation : (SettlementObservation) -> (variant { ok : record { obligation_id : Id; version : Version; duplicate : bool }; err : ApiError }); propose_oracle_observation : (record { observation_id : Id; kind : variant { world_gdp; token_price }; asset : opt text; value_e8 : nat64; observed_at : Timestamp; provenance_commitment : blob; expected_version : Version }) -> (variant { ok : record { version : Version; duplicate : bool }; err : ApiError }) }
