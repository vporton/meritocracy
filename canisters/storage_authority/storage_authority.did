type WriteResult =
 variant {
   acknowledged;
   blocked;
   conflict;
   storageError;
 };
type RoleAssignmentInput =
 record {
   contentHash: blob;
   desiredVersion: nat64;
   logicalId: text;
   "principal": principal;
   role: text;
 };
type ProbeResult =
 variant {
   allowed;
   anonymousCaller;
   callerNotAllowed;
   invalidConfiguration;
   malformedLogicalId;
 };
type PrincipalBindingInput =
 record {
   contentHash: blob;
   desiredVersion: nat64;
   factor: variant {
             internetIdentity;
             oauth;
           };
   logicalId: text;
   "principal": principal;
   provider: opt text;
   subjectHash: opt blob;
   userId: nat64;
 };
type PolicyAudit =
 record {
   archive: principal;
   core: principal;
   evidence: principal;
   governance: principal;
   treasury: principal;
   workflow: principal;
 };
type Config =
 record {
   archive: principal;
   core: principal;
   evidence: principal;
   governance: principal;
   treasury: principal;
   workflow: principal;
 };
type BindingObservation =
 variant {
   absent;
   conflict;
   present: record {
              contentHash: blob;
              version: nat64;
            };
   storageError;
 };
/// M1 storage-authority boundary scaffold.
