type _anon_class_23_1 =
 service {
   aiArtifactReadProbe: (logicalId: text) -> (ProbeResult);
   aiArtifactWriteProbe: (logicalId: text) -> (ProbeResult);
   coreBanVoteReadProbe: (logicalId: text) -> (ProbeResult);
   coreBanVoteWriteProbe: (logicalId: text) -> (ProbeResult);
   coreEmailEvidenceReadProbe: (logicalId: text) -> (ProbeResult);
   coreEmailEvidenceWriteProbe: (logicalId: text) -> (ProbeResult);
   coreHoldReadProbe: (logicalId: text) -> (ProbeResult);
   coreHoldWriteProbe: (logicalId: text) -> (ProbeResult);
   corePayoutDestinationReadProbe: (logicalId: text) -> (ProbeResult);
   corePayoutDestinationWriteProbe: (logicalId: text) -> (ProbeResult);
   corePrincipalBindingReadProbe: (logicalId: text) -> (ProbeResult);
   corePrincipalBindingWriteProbe: (logicalId: text) -> (ProbeResult);
   coreProfileReadProbe: (logicalId: text) -> (ProbeResult);
   coreProfileWriteProbe: (logicalId: text) -> (ProbeResult);
   coreRoleAssignmentReadProbe: (logicalId: text) -> (ProbeResult);
   coreRoleAssignmentWriteProbe: (logicalId: text) -> (ProbeResult);
   coreUserReadProbe: (logicalId: text) -> (ProbeResult);
   coreUserWriteProbe: (logicalId: text) -> (ProbeResult);
   evidenceKycReadProbe: (logicalId: text) -> (ProbeResult);
   evidenceKycWriteProbe: (logicalId: text) -> (ProbeResult);
   /// Fixed recovery lookup for the principal-binding collection. An
   /// unauthorized caller gets `#conflict`, never an existence signal.
   lookupCorePrincipalBinding: (logicalId: text) -> (BindingObservation);
   /// Fixed recovery lookup for role assignments. It is deliberately separate
   /// from the binding lookup, and returns no role or principal data. An
   /// unauthorized caller gets `#conflict`, never an existence signal.
   lookupCoreRoleAssignment: (logicalId: text) -> (RoleObservation);
   /// Returns only the immutable recovery tuple to the configured archive
   /// canister. Other callers cannot learn receipt existence.
   lookupMigrationReceipt: (logicalId: text) -> (Observation);
   /// Unauthorized callers receive conflict rather than an existence signal;
   /// authorized recovery receives only the immutable version/hash tuple.
   lookupTreasuryJournalEntry: (logicalId: text) -> (Observation);
   /// Unauthorized callers receive `#conflict`, never an existence signal.
   lookupTreasuryPaymentOperation: (logicalId: text) -> (Observation);
   /// Unauthorized callers receive conflict rather than a receipt-existence
   /// signal; successful recovery exposes only version/hash.
   lookupWorkflowCompletionReceipt: (logicalId: text) -> (Observation);
   migrationEvidenceReadProbe: (logicalId: text) -> (ProbeResult);
   migrationEvidenceWriteProbe: (logicalId: text) -> (ProbeResult);
   migrationReceiptReadProbe: (logicalId: text) -> (ProbeResult);
   migrationReceiptWriteProbe: (logicalId: text) -> (ProbeResult);
   /// The governance-only audit is the sole administrative endpoint. It grants
   /// neither data access nor a way to alter the fixed matrix after install.
   policyAudit: () -> (opt PolicyAudit);
   treasuryChainReceiptReadProbe: (logicalId: text) -> (ProbeResult);
   treasuryChainReceiptWriteProbe: (logicalId: text) -> (ProbeResult);
   treasuryJournalReadProbe: (logicalId: text) -> (ProbeResult);
   treasuryJournalWriteProbe: (logicalId: text) -> (ProbeResult);
   treasuryObligationReadProbe: (logicalId: text) -> (ProbeResult);
   treasuryObligationWriteProbe: (logicalId: text) -> (ProbeResult);
   treasuryPaymentOperationReadProbe: (logicalId: text) -> (ProbeResult);
   treasuryPaymentOperationWriteProbe: (logicalId: text) -> (ProbeResult);
   workflowCompletionReceiptReadProbe: (logicalId: text) -> (ProbeResult);
   workflowCompletionReceiptWriteProbe: (logicalId: text) -> (ProbeResult);
   workflowResultReadProbe: (logicalId: text) -> (ProbeResult);
   workflowResultSourceReadProbe: (logicalId: text) -> (ProbeResult);
   workflowResultSourceWriteProbe: (logicalId: text) -> (ProbeResult);
   workflowResultWriteProbe: (logicalId: text) -> (ProbeResult);
   workflowScheduleReadProbe: (logicalId: text) -> (ProbeResult);
   workflowScheduleWriteProbe: (logicalId: text) -> (ProbeResult);
   /// Fixed principal-binding write. This is intentionally not a generic
   /// storage method: only the configured core actor may call it, and the
   /// adapter accepts immutable logical-ID/version/hash records only.
   writeCorePrincipalBinding: (input: PrincipalBindingInput) -> (WriteResult);
   /// Fixed role-assignment write. Role revocation remains a later immutable
   /// logical record; this endpoint cannot overwrite an existing assignment.
   writeCoreRoleAssignment: (input: RoleAssignmentInput) -> (WriteResult);
   /// Fixed archive-only receipt write. It is not an importer: callers cannot
   /// supply source rows, credentials, a collection name, or an arbitrary key.
   writeMigrationReceipt: (input: Input__3) -> (WriteResult);
   /// Fixed treasury-only immutable journal-entry write. It neither computes a
   /// balance nor accepts a destination, signer, transaction, or chain receipt.
   writeTreasuryJournalEntry: (input: Input__2) -> (WriteResult);
   /// Fixed treasury-only immutable payment-operation write. This is not a
   /// signer, transfer, activation, journal, or generic storage endpoint.
   writeTreasuryPaymentOperation: (input: Input__1) -> (WriteResult);
   /// Fixed workflow-only completion receipt write. This neither receives nor
   /// stores workflow payloads, task inputs, provider responses, or callers.
   writeWorkflowCompletionReceipt: (input: Input) -> (WriteResult);
 };
type WriteResult = 
 variant {
   acknowledged;
   blocked;
   conflict;
   storageError;
 };
type RoleObservation = 
 variant {
   absent;
   conflict;
   present: record {
              contentHash: blob;
              version: nat64;
            };
   storageError;
 };
type RoleAssignmentInput = 
 record {
   contentHash: blob;
   desiredVersion: nat64;
   logicalId: text;
   "principal": principal;
   role: text;
 };
type ProbeResult = 
 variant {
   allowed;
   anonymousCaller;
   callerNotAllowed;
   invalidConfiguration;
   malformedLogicalId;
 };
type PrincipalBindingInput = 
 record {
   contentHash: blob;
   desiredVersion: nat64;
   factor: variant {
             internetIdentity;
             oauth;
           };
   logicalId: text;
   "principal": principal;
   provider: opt text;
   subjectHash: opt blob;
   userId: nat64;
 };
type PolicyAudit = 
 record {
   archive: principal;
   core: principal;
   evidence: principal;
   governance: principal;
   treasury: principal;
   workflow: principal;
 };
type Observation = 
 variant {
   absent;
   conflict;
   present: record {
              contentHash: blob;
              version: nat64;
            };
   storageError;
 };
type Input__3 =
 record {
   chunk: nat64;
   contentHash: blob;
   desiredVersion: nat64;
   logicalId: text;
   migrationId: text;
   payloadHash: blob;
   rowCount: nat32;
   sourceTable: text;
 };
type Input__2 =
 record {
   accountId: text;
   amountBaseUnits: nat;
   assetDecimals: nat8;
   assetId: text;
   contentHash: blob;
   desiredVersion: nat64;
   direction: Direction;
   journalSequence: nat64;
   logicalId: text;
   operationId: text;
 };
type Input__1 =
 record {
   amountBaseUnits: nat;
   assetDecimals: nat8;
   assetId: text;
   contentHash: blob;
   desiredVersion: nat64;
   destinationHash: blob;
   logicalId: text;
   obligationId: text;
   operationId: text;
 };
type Input =
 record {
   contentHash: blob;
   cycleId: text;
   desiredVersion: nat64;
   logicalId: text;
   operationName: text;
 };
type Direction =
 variant {
   credit;
   debit;
 };
type Config = 
 record {
   archive: principal;
   core: principal;
   evidence: principal;
   governance: principal;
   treasury: principal;
   workflow: principal;
 };
type BindingObservation = 
 variant {
   absent;
   conflict;
   present: record {
              contentHash: blob;
              version: nat64;
            };
   storageError;
 };
/// M1 storage-authority boundary scaffold.
/// 
/// This canister exposes only a bounded, collection-specific M1 surface. It
/// has no generic ZenDB, grant-management, collection, action, document-ID,
/// or filter API. The fixed identity/role methods below remain un-deployed
/// proof work and are not an authoritative-store claim.
service : (initialConfig: Config) -> _anon_class_23_1
