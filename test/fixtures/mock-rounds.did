type RoundId = nat64;
type AllocationId = nat64;
type Hash32 = blob;
type AssetId = record { ledger : principal; symbol : text; decimals : nat8 };
type Account = record { owner : principal; subaccount : opt blob };
type AppError = variant { unauthorized; forbidden; not_found; conflict : text; invalid : text; expired; rate_limited : record { retry_after_ns : nat64 }; paused; transient : text; internal : text };
type Reservation = record { round_id : RoundId; asset : AssetId; fund : Hash32; required_atoms : nat; reserved_atoms : nat; fee_budget_atoms : nat; accounting_deficit_atoms : nat; finalized_outstanding_atoms : opt nat; finalized_outstanding_count : opt nat32; allocation_version : Hash32; transfer_count : nat32; account : Account };
type Transfer = record { allocation_id : AllocationId; to : Account; amount_atoms : nat; fee_atoms : opt nat; memo : Hash32; created_at_time : nat64; state : variant { prepared; executing : nat32; sent : nat; retryable_failure : text; permanent_failure : text } };
type PreparedTransfer = record { allocation_id : AllocationId; to : Account; amount_atoms : nat; memo : Hash32; created_at_time : nat64 };
type BatchExecution = record { round_id : RoundId; transfers : vec Transfer };
type ResultReservation = variant { ok : Reservation; err : AppError };
type ResultBatch = variant { ok : BatchExecution; err : AppError };
service : {
  configure_vault : (principal) -> ();
  reserve_round : (record { round_id : RoundId; asset : AssetId; fund : Hash32; required_atoms : nat; allocation_version : Hash32; transfer_count : nat32 }) -> (ResultReservation);
  execute_batch : (record { round_id : RoundId; allocation_version : Hash32; transfers : vec PreparedTransfer }) -> (ResultBatch);
  close_round : (record { round_id : RoundId; outstanding_atoms : nat; outstanding_count : nat32 }) -> (ResultReservation);
}
