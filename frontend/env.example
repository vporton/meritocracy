# Self URL
VITE_FRONTEND_URL=http://localhost:5173

# API Configuration
VITE_API_URL=http://localhost:3001

# Web3/Ethereum Configuration
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# OAuth Configuration
# OAuth client IDs and secrets are configured only on the backend.

# OAuth Configuration
VITE_ORCID_DOMAIN=orcid.org
# ICP runtime configuration. Canister IDs are supplied by dfx/deployment and
# must not be hard-coded in application source.
VITE_DFX_NETWORK=local
VITE_IC_HOST=http://127.0.0.1:4943
VITE_CANISTER_ID_REGISTRY=
VITE_CANISTER_ID_ASSESSMENT=
VITE_CANISTER_ID_ROUNDS=
VITE_CANISTER_ID_VAULT=
VITE_CANISTER_ID_AUDIT=
