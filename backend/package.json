    "@dfinity/ledger-icp": "^9.1.0",
    "@dfinity/principal": "^3.4.3",
    "@polkadot/api": "^16.5.4",
    "@polkadot/keyring": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^14.5.0",
    "@types/node": "^25.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "7.0.11",
    "bcrypt": "^6.0.0",
    "bitcoin-core": "^5.0.0",
    "bitcoinjs-lib": "7.0.1",
    "bs58": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "ecpair": "^3.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "flexible-batches": "^0.3.7",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.1",
    "openai": "^6.22.0",
