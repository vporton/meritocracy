type UserId = nat64;
type EvaluationId = nat64;
type Hash32 = blob;
type TimestampNs = int;
type AppError = variant { unauthorized; forbidden; not_found; conflict : text; invalid : text; expired; rate_limited : record { retry_after_ns : nat64 }; paused; transient : text; internal : text };
type InterfaceVersion = record { major : nat16; minor : nat16; patch : nat16; schema_hash : Hash32 };
type Page = record { cursor : opt blob; limit : nat32 };
type SourceRef = record { ordinal : nat32; uri_hash : Hash32; allowed_uri : opt text };
type FailureClass = variant { provider_unavailable; timeout; malformed_response; policy_rejected; internal };
type EvaluationOutcome = variant { accepted : record { weight_numerator : nat; weight_denominator : nat }; rejected : text };
type EvaluationStatus = variant { pending; complete; failed : FailureClass };
type Evaluation = record {
  id : EvaluationId;
  idempotency_key : Hash32;
  request_fingerprint : Hash32;
  subject_user_id : UserId;
  input_hash : Hash32;
  source_refs : vec SourceRef;
  prompt_version : Hash32;
  model_version : text;
  result_hash : opt Hash32;
  outcome : opt EvaluationOutcome;
  status : EvaluationStatus;
  attempt : nat32;
  attempt_token : Hash32;
  created_at : TimestampNs;
  updated_at : TimestampNs;
};
type AllocationProposal = record { evaluation_id : EvaluationId; user_id : UserId; weight_numerator : nat; weight_denominator : nat; evidence_hash : Hash32 };
type EvaluationPage = record { items : vec Evaluation; next_cursor : opt blob };
type Config = record {
  submitters : vec principal;
  audit_canister : opt principal;
  allowed_models : vec text;
  allowed_prompt_versions : vec Hash32;
  allowed_source_hosts : vec text;
  max_input_bytes : nat;
  max_sources : nat;
  max_weight_numerator : nat;
  rate_limit_count : nat32;
  rate_limit_window_ns : nat64;
  max_attempts : nat32;
};
type ResultUnit = variant { ok; err : AppError };
type ResultEvaluation = variant { ok : Evaluation; err : AppError };
type ResultPage = variant { ok : EvaluationPage; err : AppError };
type ResultProposal = variant { ok : AllocationProposal; err : AppError };
service : {
  configure : (Config) -> (ResultUnit);
  configure_registry : (principal) -> (ResultUnit);
  configure_budget : (record { paused : bool; global_limit : nat32; per_caller_limit : nat32; window_ns : nat64 }) -> (ResultUnit);
  budget_status : () -> (record { paused : bool; global_limit : nat32; global_used : nat32; per_caller_limit : nat32; window_ns : nat64 }) query;
  interface_version : () -> (InterfaceVersion) query;
  submit_evaluation : (record { idempotency_key : Hash32; subject_user_id : UserId; input_text : text; source_refs : vec SourceRef; prompt_version : Hash32; model_version : text }) -> (ResultEvaluation);
  retry_evaluation : (record { evaluation_id : EvaluationId; input_text : text }) -> (ResultEvaluation);
  get_evaluation : (EvaluationId) -> (ResultEvaluation) query;
  get_evaluation_by_key : (Hash32) -> (ResultEvaluation) query;
  list_evaluations : (record { subject : opt UserId; page : Page }) -> (ResultPage) query;
  propose_allocation : (EvaluationId) -> (ResultProposal) query;
}
