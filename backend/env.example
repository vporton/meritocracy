# Unique ID of our app installation:
INSTALLATION_UID=your-guid

# Database Configuration
# Choose one of the following database URLs and uncomment it:

# SQLite (default for development)
DATABASE_URL="file:./dev.db"

# PostgreSQL
# DATABASE_URL="postgresql://username:password@localhost:5432/meritocracy?schema=public"

# MySQL
# DATABASE_URL="mysql://username:password@localhost:3306/meritocracy"

# Server Configuration
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Multi-Network Ethereum Configuration
# Each network can be enabled/disabled independently
# Private key is shared across all networks (same address on all networks)

# Mainnet Configuration
ETHEREUM_MAINNET_ENABLED=true
ETHEREUM_MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# CELO Configuration
ETHEREUM_CELO_ENABLED=true
ETHEREUM_CELO_RPC_URL=https://celo-json-rpc.stakely.io

# Polygon Configuration
ETHEREUM_POLYGON_ENABLED=false
ETHEREUM_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_PROJECT_ID

# Arbitrum Configuration
ETHEREUM_ARBITRUM_ENABLED=false
ETHEREUM_ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_PROJECT_ID

# Optimism Configuration
ETHEREUM_OPTIMISM_ENABLED=false
ETHEREUM_OPTIMISM_RPC_URL=https://optimism-mainnet.infura.io/v3/YOUR_PROJECT_ID

# Base Configuration
ETHEREUM_BASE_ENABLED=false
ETHEREUM_BASE_RPC_URL=https://base-mainnet.infura.io/v3/YOUR_PROJECT_ID

# Sepolia Testnet Configuration
ETHEREUM_SEPOLIA_ENABLED=false
ETHEREUM_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Localhost Development Configuration
ETHEREUM_LOCALHOST_ENABLED=false
ETHEREUM_LOCALHOST_RPC_URL=http://localhost:8545

# Solana Configuration
SOLANA_ENABLED=true
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Bitcoin Configuration
BITCOIN_ENABLED=true
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_RPC_USERNAME=your-bitcoin-rpc-username
BITCOIN_RPC_PASSWORD=your-bitcoin-rpc-password

# Polkadot Configuration
POLKADOT_ENABLED=true
POLKADOT_RPC_URL=https://rpc.polkadot.io

# Cosmos Configuration
COSMOS_ENABLED=false
COSMOS_RPC_URL=https://cosmos-rpc.publicnode.com:443

# Stellar Configuration
STELLAR_ENABLED=false
STELLAR_HORIZON_URL=https://horizon.stellar.org
# Default passphrase for public network; override for Testnet or custom networks.
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# ICP Configuration
ICP_ENABLED=false
ICP_HOST=https://ic0.app
ICP_LEDGER_CANISTER_ID=ryjl3-tyaaa-aaaaa-aaaba-cai
# ICP account identifier or principal for displaying balances (optional if identity is configured)
ICP_WALLET_ADDRESS=
# Base64-encoded PEM for the sender identity.
ICP_IDENTITY_PEM_BASE64=
# Optional, overrides the base64 field when providing a raw PEM string.
ICP_IDENTITY_PEM=
# Ledger transfer fee in e8s (default: 10000).
ICP_TRANSFER_FEE_E8S=10000
# Optional per-token ledger overrides for ICRC-1 ck assets.
ICP_CKBTC_LEDGER_CANISTER_ID=mxzaz-hqaaa-aaaar-qaada-cai
ICP_CKETH_LEDGER_CANISTER_ID=ss2fx-dyaaa-aaaar-qacoq-cai
ICP_CKETH_HELPER_CONTRACT_ADDRESS=0x6abDA0438307733FC299e9C229FD3cc074bD8cC0
ICP_CKUSDT_LEDGER_CANISTER_ID=cngnf-vqaaa-aaaar-qag4q-cai
# Optional override. Defaults to Ethereum mainnet USDT if blank.
ICP_CKUSDT_ERC20_CONTRACT_ADDRESS=
ICP_CKUSDC_LEDGER_CANISTER_ID=xevnm-gaaaa-aaaar-qafnq-cai
# Optional override. Defaults to Ethereum mainnet USDC if blank.
ICP_CKUSDC_ERC20_CONTRACT_ADDRESS=
ICP_CKEURC_LEDGER_CANISTER_ID=pe5t5-diaaa-aaaar-qahwa-cai
# Optional override. Defaults to Ethereum mainnet EURC if blank.
ICP_CKEURC_ERC20_CONTRACT_ADDRESS=

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OAuth Provider Configuration
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Note: Redirect URI should be ${API_URL}/api/auth/github/callback

# ORCID OAuth
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret
ORCID_DOMAIN=sandbox.orcid.org

# BitBucket OAuth
BITBUCKET_CLIENT_ID=your-bitbucket-client-id
BITBUCKET_CLIENT_SECRET=your-bitbucket-client-secret

# GitLab OAuth
GITLAB_CLIENT_ID=your-gitlab-client-id
GITLAB_CLIENT_SECRET=your-gitlab-client-secret

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
# Optional CoinGecko demo key for live treasury token prices
COINGECKO_DEMO_API_KEY=
# For production recommended gpt-5, for cheap testing use gpt-5-mini (don't use gpt-5-nano: it tends to enter infinite loop with Web search)
OPENAI_MODEL=gpt-5
# batch (for production, not yet debugged) or nonbatch (useful for debugging)
OPENAI_FLEX_MODE=nonbatch
# Do no reasoning
OPENAI_NO_REASONING=yes
# minimal` cannot search Web:
OPENAI_OVERRIDE_REASONING_EFFORT=medium
# Limit the number of tool (search) calls
OPENAI_OVERRIDE_MAX_TOOL_CALLS=2
# OpenAI Fake Mode (for testing/development)
# When set to true, replaces OpenAI outputs with predefined values:
# - onboarding: true
# - worth: 0.1% of GDP
# - injection: no injection
# - prompt randomization: don't randomize (pass the prompt as is)
OPEN_AI_FAKE=true

# Email Configuration (for email verification and KYC requests)
# SMTP Configuration for sending verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Note: For Gmail, you need to use an App Password, not your regular password
# Generate one at: https://myaccount.google.com/apppasswords

# Didit.me verification:
DIDIT_APP_ID=your-didid-app-id
DIDID_APP_KEY=your-didid-api-key
DIDIT_WEBHOOK_KEY=your-didid-webhook-key
DIDIT_WORKFLOW_RECEIVING_ID=your-didid-workflow-id
DIDIT_WORKFLOW_VOTING_ID=00514a1a-aa74-47a6-a50f-fe4722952b86
DIDIT_WORKFLOW_LIVELINESS_ID=your-didit-liveliness-workflow-id
DIDIT_API_KEY=your-didit-api-key
# A successful Didit Liveliness check is required before payout and remains valid this many months.
DIDIT_LIVELINESS_INTERVAL_MONTHS=3

# KYC Configuration
# Set to true to skip KYC verification and automatically set users as verified
SKIP_KYC=true

# System Secret Service
# Private key used for country-specific distributions if not explicitly provided
SYSTEM_ETHEREUM_PRIVATE_KEY=your-system-private-key

# Admin Password
ADMIN_PASSWORD=your-admin-password
