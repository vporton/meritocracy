type UserId = nat64;
type PayoutAccountId = nat64;
type RoundId = nat64;
type Hash32 = blob;
type TimestampNs = int;
type NetworkId = variant { icp; bitcoin; ethereum; solana; polkadot; stellar; cosmos; bitcoin_cash; other : text };
type AssetId = record { ledger : principal; symbol : text; decimals : nat8 };
type Route = record { network : NetworkId; asset : opt AssetId };
type AppError = variant { unauthorized; forbidden; not_found; conflict : text; invalid : text; expired; rate_limited : record { retry_after_ns : nat64 }; paused; transient : text; internal : text };
type ResultUnit = variant { ok; err : AppError };
type InterfaceVersion = record { major : nat16; minor : nat16; patch : nat16; schema_hash : Hash32 };
type PublicProfile = record { user_id : UserId; name : opt text; created_at : TimestampNs; status : variant { active; banned : TimestampNs; deleted } };
type LegacyUserMapping = record {
  source_namespace : text;
  legacy_user_id : text;
  user_id : UserId;
  imported_profile : record { name : opt text; created_at : TimestampNs; status : variant { active; banned : TimestampNs; deleted } };
};
type User = record { profile : PublicProfile; eligibility : EligibilityState };
type EligibilityState = record { status : variant { unknown; eligible; ineligible; expired }; issuer : opt text; reference_hash : opt Hash32; expires_at : opt TimestampNs };
type Session = record { session_principal : principal; user_id : UserId; issuer : variant { ethereum_wallet; internet_identity; oauth : text }; issued_at : TimestampNs; expires_at : TimestampNs; revoked_at : opt TimestampNs };
type PayoutAccount = record { id : PayoutAccountId; user_id : UserId; route : Route; address : text; normalized_address : text; verification : variant { pending; legacy_imported; verified; revoked }; active : bool; default_for_route : bool; created_at : TimestampNs; verified_at : opt TimestampNs };
type IcrcAccount = record { owner : principal; subaccount : opt blob };
type RecipientSnapshot = record { user_id : UserId; payout_account_id : PayoutAccountId; route : Route; normalized_address : text; icrc_account : opt IcrcAccount; captured_at : TimestampNs };
type CarriedBalance = record { asset : AssetId; atoms : nat; source_round : RoundId; reason : text };
type Page = record { cursor : opt blob; limit : nat32 };
type ProfilePage = record { items : vec PublicProfile; next_cursor : opt blob };
type OAuthStart = record { login_url : text; attempt_id : blob; expires_at : TimestampNs };
type Challenge = record { challenge_id : blob; message : text; expires_at : TimestampNs };
type HeaderField = record { text; text };
type HttpUpdateRequest = record { url : text; method : text; headers : vec HeaderField; body : blob };
type HttpRequest = record { url : text; method : text; headers : vec HeaderField; body : blob; certificate_version : opt nat16 };
type StreamingCallbackResponse = record { body : blob; token : opt blob };
type StreamingStrategy = variant { Callback : record { callback : func (blob) -> (opt StreamingCallbackResponse) query; token : blob } };
type HttpUpdateResponse = record { status_code : nat16; headers : vec HeaderField; body : blob; streaming_strategy : opt StreamingStrategy };
type HttpResponse = record { status_code : nat16; headers : vec HeaderField; body : blob; streaming_strategy : opt StreamingStrategy; upgrade : opt bool };
type HttpHeader = record { name : text; value : text };
type HttpRequestResult = record { status : nat; headers : vec HttpHeader; body : blob };
type TransformArg = record { context : blob; response : HttpRequestResult };
type SignedAttestation = record { user_id : UserId; issuer : text; status : variant { eligible; ineligible }; reference_hash : Hash32; issued_at : TimestampNs; expires_at : opt TimestampNs; signature : blob };
type ProfilePatch = record { name : opt text };
type PayoutAccountInput = record { route : Route; address : text };
type ResultSession = variant { ok : Session; err : AppError };
type ResultUser = variant { ok : User; err : AppError };
type ResultProfile = variant { ok : PublicProfile; err : AppError };
type ResultProfiles = variant { ok : ProfilePage; err : AppError };
type ResultLegacyMapping = variant { ok : LegacyUserMapping; err : AppError };
type ResultLegacyMappings = variant { ok : record { items : vec LegacyUserMapping; next_cursor : opt blob }; err : AppError };
type ResultAccount = variant { ok : PayoutAccount; err : AppError };
type ResultAccounts = variant { ok : vec PayoutAccount; err : AppError };
type ResultChallenge = variant { ok : Challenge; err : AppError };
type ResultOAuth = variant { ok : OAuthStart; err : AppError };
type ResultEligibility = variant { ok : EligibilityState; err : AppError };
type ResultBalances = variant { ok : vec CarriedBalance; err : AppError };
type ResultCarriedBalance = variant { ok : CarriedBalance; err : AppError };
type ResultRecipient = variant { ok : RecipientSnapshot; err : AppError };
type ResultAuthorization = variant { ok : record { user_id : UserId; expires_at : TimestampNs }; err : AppError };
type OAuthProviderInput = record { kind : variant { github; google }; client_id : text };
type AuthorityConfig = record {
  rounds_canister : opt principal;
  session_consumers : vec principal;
  attestation_issuers : vec record { name : text; caller : principal; public_key : blob };
  allowed_domains : vec text;
  allowed_actions : vec text;
  oauth_site_url : text;
  oauth_providers : vec OAuthProviderInput;
  oauth_redirect_uris : vec text;
};
service : {
  configure_authorities : (AuthorityConfig) -> (ResultUnit);
  interface_version : () -> (InterfaceVersion) query;
  begin_ethereum_login : (record { address : text; session_principal : principal; requested_action : text; domain : text }) -> (ResultChallenge);
  complete_ethereum_login : (record { challenge_id : blob; signature : blob; public_key : blob }) -> (ResultSession);
  complete_internet_identity_login : (record { session_principal : principal; requested_action : text }) -> (ResultSession);
  begin_oauth_login : (record { provider : text; session_principal : principal; redirect_uri : text }) -> (ResultOAuth);
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_update : (HttpUpdateRequest) -> (HttpUpdateResponse);
  oauthTransform : (TransformArg) -> (HttpRequestResult) query;
  me : () -> (ResultUser) query;
  get_public_profile : (UserId) -> (ResultProfile) query;
  list_public_profiles : (Page) -> (ResultProfiles) query;
  import_legacy_profile : (record { source_namespace : text; legacy_user_id : text; name : opt text; created_at : TimestampNs; status : variant { active; banned : TimestampNs; deleted } }) -> (ResultLegacyMapping);
  get_legacy_user_mapping : (text, text) -> (ResultLegacyMapping) query;
  list_legacy_user_mappings : (Page) -> (ResultLegacyMappings) query;
  update_public_profile : (ProfilePatch) -> (ResultUser);
  add_payout_account : (PayoutAccountInput) -> (ResultAccount);
  import_legacy_payout_account : (UserId, PayoutAccountInput) -> (ResultAccount);
  begin_payout_proof : (PayoutAccountId) -> (ResultChallenge);
  complete_payout_proof : (PayoutAccountId, blob) -> (ResultAccount);
  complete_icrc_payout_proof : (PayoutAccountId) -> (ResultAccount);
  set_payout_account_active : (PayoutAccountId, bool) -> (ResultAccount);
  set_default_payout_account : (PayoutAccountId) -> (ResultAccount);
  revoke_payout_account : (PayoutAccountId) -> (ResultAccount);
  list_my_payout_accounts : () -> (ResultAccounts) query;
  revoke_session : (principal) -> (ResultUnit);
  revoke_all_sessions : () -> (ResultUnit);
  current_session : () -> (ResultSession) query;
  authorize_session : (principal) -> (ResultAuthorization);
  snapshot_recipient : (record { user_id : UserId; route : Route; round_id : RoundId }) -> (ResultRecipient);
  get_eligibility : (UserId) -> (ResultEligibility) query;
  put_attestation : (SignedAttestation) -> (ResultEligibility);
  get_carried_balances : (UserId) -> (ResultBalances) query;
  credit_carried_balance : (record { user_id : UserId; balance : CarriedBalance; allocation_id : nat64 }) -> (ResultUnit);
  consume_carried_balance : (record { allocation_id : nat64; target_round : RoundId }) -> (ResultCarriedBalance);
}
